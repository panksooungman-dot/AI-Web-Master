# Auth data store (Supabase, server-side only — NOT NEXT_PUBLIC_*).
# Required in production (Vercel): lib/db/index.ts's getDefaultStore() fails fast with
# "[Production misconfig] ..." (surfaced as 400 by /api/auth/login) when either is missing
# and NODE_ENV=production. Locally (next dev), missing values fall back to a fs-backed store,
# so these can stay empty for local development.
# NOTE: distinct from NEXT_PUBLIC_SUPABASE_URL/NEXT_PUBLIC_SUPABASE_ANON_KEY used by the
# unrelated root-level lib/supabase.ts (v1 legacy site) — this app needs the service role key,
# not the anon key.
#
# 같은 값을 lib/uploads/storage.ts(Inquiry 첨부파일 저장)도 재사용한다 — Storage 쪽에
# "inquiry-uploads"라는 이름의 버킷이 먼저 생성돼 있어야 한다(Storage buckets은 API로
# 자동 생성하지 않음). 비어 있으면 로컬 fs(apps/cnbiz-web/lib/data/uploads/, machine-local)로
# 조용히 폴백하므로 로컬 개발에는 필수가 아니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications for the cnbiz.ai.kr chatbot inquiry pipeline (lib/inquiries/notify.ts).
# Originally built for the public Contact form (now removed — CNBIZ.KR no longer takes website
# requests directly), lib/contact/email/* was kept as-is and reused here rather than duplicated.
# Leave CONTACT_EMAIL_PROVIDER unset (or set to a value with no matching case) to skip email
# sending — inquiries are still saved to the registry either way.

# Provider to use. Supported: "resend". Add a new case in lib/contact/email/index.ts
# and a provider file under lib/contact/email/providers/ to support another one.
CONTACT_EMAIL_PROVIDER=resend

# Notification recipient/sender
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# Resend (used when CONTACT_EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Slack notification for new inquiries (optional, lib/inquiries/notify.ts's
# notifyAdminOfNewInquirySlack) — runs alongside the email notification above, not instead of it.
# Create a Slack Incoming Webhook (https://api.slack.com/messaging/webhooks) and paste its URL
# here. Leave empty to skip Slack notifications (email still sends independently).
SLACK_WEBHOOK_URL=

# Google Analytics 4 (optional). Only loaded in production (NODE_ENV=production) and only when
# set — see app/layout.tsx. Leave empty locally/in preview to skip loading gtag.js entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Figma Import/Export — Design Automation Phase 7 (optional). Without it, lib/design/figma-generator.ts
# falls back to deterministic simulated content instead of calling the real Figma REST API.
FIGMA_API_TOKEN=

# Local Ollama endpoint for AI Provider status (optional). Defaults to http://localhost:11434
# (see lib/providers/status.ts) — only set this if Ollama runs somewhere else.
OLLAMA_HOST=

# AI 홈페이지 무료 제작 CTA(Header/Footer/Hero/CTASection 등)와 /request redirect가 이동할 대상.
# /contact는 AI Business OS Rewiring으로 cnbiz.kr의 자체 문의 폼(POST /api/inquiries로 제출)이라
# 더 이상 이동 대상이 아니다. 비워두면 https://cnbiz.ai.kr로 폴백한다 (lib/links.ts).
NEXT_PUBLIC_CNBIZ_AI_URL=

# 홈페이지 하단 CTA 배너("프로젝트 문의하기")의 연결 대상. 비워두면
# https://cnbiz.ai.kr/quote로 폴백한다 (lib/links.ts).
NEXT_PUBLIC_CNBIZ_QUOTE_URL=

# @deprecated AI Business OS Rewiring — cnbiz.ai.kr 챗봇이 POST /api/external/inquiries를
# 서버-투-서버로 호출할 때 보내는 x-api-key 헤더 값 (lib/auth/apiKey.ts, 마찬가지로 deprecated).
# 실제로는 Production에 한 번도 설정된 적이 없어(REWIRING_REPORT.md) 그 라우트는 배포 이후 항상
# 401만 반환해왔다. 고객 접수는 이제 POST /api/inquiries(내부, API Key 불필요)로 대체되었다.
# 이 값은 /api/external/**가 실제로 제거되기 전까지만 참고용으로 남겨둔다.
CHATBOT_API_KEY=

# AI Business OS Rewiring Phase 3 — 고객별 독립 GitHub Repository/Vercel Project 자동 생성
# (lib/deployment/pipeline.ts). 둘 다 없으면 lib/github/client.ts·lib/vercel/client.ts가 실제
# API를 호출하지 않고, AI Generate 성공 후 배포 파이프라인은 WebsiteRecord.deploymentStatus를
# "NotConfigured"로 남긴 채 조용히 건너뛴다(PHASE3_REPORT.md — 이 값들은 이 환경에 설정된 적이
# 없어 실제 계정으로 검증하지 못했다).

# GitHub Personal Access Token — repo 생성/삭제 권한(classic PAT의 "repo" scope, 또는
# fine-grained PAT의 Administration:write) 필요. lib/github/client.ts.
GITHUB_TOKEN=

# 저장소를 만들 조직(organization) 이름. 비워두면 토큰 소유자의 개인 계정 아래
# (POST /user/repos)에 생성한다.
GITHUB_OWNER=

# Vercel API Token — https://vercel.com/account/tokens . lib/vercel/client.ts.
VERCEL_TOKEN=

# 팀(Team) 스코프 토큰인 경우에만 필요(모든 요청에 ?teamId= 로 첨부됨). 개인 계정 토큰이면
# 비워둔다.
VERCEL_TEAM_ID=

# ---------------------------------------------------------------------------
# AI Provider (packages/cli) — AI 분석·견적서·명세서·일정·계약서·제안서·Design 체인이
# lib/ai/bridge.ts를 통해 packages/cli를 실행할 때 사용한다.
#
# 하나도 설정하지 않아도 시스템은 정상 동작하지만, 모든 산출물이 AI 판단 없이 결정론적
# 기본값으로 생성된다(화면에 "Simulated" 배지, AI 분석 요약에 "기본값으로 대체된 요약입니다").
# 즉 값이 비어 있는 것과 잘못 설정된 것을 겉으로 구분하기 어려우므로, 실제 AI 결과가
# 필요하면 반드시 아래 중 하나를 채운다.
#
# 기본으로 사용할 provider. 지원: anthropic | openai | gemini | ollama | openrouter.
# 비워두면 packages/cli의 기본값인 "anthropic"을 쓴다.
#
# 이 변수가 필요한 이유: packages/cli는 원래 .runtime/config/providers.json의 default
# 필드를 읽는데, Vercel 같은 서버리스에서는 그 파일이 요청마다 새로 만들어지는 임시
# 디렉터리에 생기므로 `ai provider set-default`로 바꿔도 다음 요청에서 사라진다.
# 배포 환경에서 기본 provider를 고정할 수 있는 수단은 이 환경변수뿐이다.
# (설정 파일보다 우선한다 — packages/cli/src/providers/manager.ts의 resolveDefaultProviderId)
AI_DEFAULT_PROVIDER=

# 위에서 고른 provider에 해당하는 키 하나만 채우면 된다.
#
# ANTHROPIC_API_KEY는 lib/ai-analysis/vision.ts(업로드 이미지 비전 분석)와
# packages/dev-inspector의 Visual Editor "AI로 수정 요청"(ai-edit.ts)도 packages/cli를
# 거치지 않고 직접 재사용한다 — 비어 있으면 각각 조용히 건너뛰거나(비전 분석) 명확한
# "설정되지 않음" 오류를 반환하고(AI로 수정 요청), 나머지 provider 선택과는 무관하다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Ollama를 쓰는 경우의 호스트(예: http://localhost:11434). 서버리스 배포에서는
# localhost에 Ollama가 없으므로 사실상 로컬 개발 전용이다.
OLLAMA_HOST=
