# 실제 도메인이 확정되면 설정한다. 비워두면 lib/site-config.ts의 임시값을 사용한다.
NEXT_PUBLIC_SITE_URL=https://saseokchanmi.com

# ── 근로계약서 관리자 기능 ──
# 관리자 로그인 비밀번호(10자 이상). 값은 채팅·코드에 적지 말고 Vercel 환경변수에만 넣는다.
CONTRACT_ADMIN_PASSWORD=
# 로그인 쿠키 서명용 무작위 문자열(32자 이상). 예: openssl rand -base64 48
CONTRACT_SESSION_SECRET=
# DB 연결 문자열(Neon Postgres). Vercel 프로젝트의 Storage 탭에서 Neon을 만들어 연결하면 자동으로 들어간다.
# 테이블은 첫 요청 때 자동으로 만들어지므로 따로 준비할 것이 없다.
# 운영에서 비어 있으면 API가 503을 돌려준다(서버리스 디스크는 영구 저장이 아니라서 파일에 쓰지 않는다).
# 개발(next dev)에서는 비워 두면 lib/data/contract/ 의 로컬 파일을 쓴다(git 미추적).
DATABASE_URL=

# ── 서명 제출 알림 (선택) ──
# 근로자가 계약서에 서명·제출하면 사업주에게 알린다. 값이 있는 채널만 켜지고, 하나도 없으면 알림 없이 동작한다.
# 값은 비밀번호와 같다. 채팅·코드에 적지 말고 Vercel 환경변수(Production)에만 넣는다. 값을 바꾼 뒤에는 재배포해야 적용된다.
# Slack: 앱의 Incoming Webhooks에서 만든 주소(https://hooks.slack.com/services/...)
SLACK_WEBHOOK_URL=
# SOLAPI 문자: 발신번호(SOLAPI_FROM)는 SOLAPI에 미리 등록·인증된 번호여야 한다. 번호는 숫자만(하이픈은 있어도 무방).
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=
SOLAPI_TO=

# ── 퇴근 누락 알림 (선택) ──
# 퇴근 기록이 빠진 직원이 있으면 매일 오전 9시(한국 시간)쯤 위의 Slack·문자로 알린다(vercel.json의 cron).
# CRON_SECRET은 아무도 추측할 수 없는 긴 임의 문자열(32자 이상)로 정한다. Vercel이 이 값으로 cron 요청을 인증하며,
# 비어 있으면 알림 주소(/api/cron/clock-missing)는 항상 503을 돌려주고 아무것도 보내지 않는다. Vercel 환경변수(Production)에 넣고 재배포한다.
CRON_SECRET=

# ── 카카오 알림톡 (선택) ──
# SOLAPI로 계약서 작성 링크·급여명세서 확정 안내·퇴근 누락 알림을 카카오톡으로 보낸다(위 SOLAPI_API_KEY/SECRET/FROM을 같이 쓴다).
# 알림톡은 SOLAPI에서 승인받은 템플릿 문구 그대로만 보낼 수 있다. 템플릿 문구는 lib/contract/server/alimtalk.ts의 ALIMTALK에 있으니 그대로 등록한다.
# 값이 비어 있으면 알림톡 버튼은 "설정되지 않았습니다"를 보여 주고, 퇴근 누락 알림은 알림톡만 건너뛴다.
# SOLAPI_KAKAO_PFID: SOLAPI 콘솔 > 카카오 채널 관리의 발신프로필 ID(pfId)
SOLAPI_KAKAO_PFID=
# 템플릿 ID(승인 완료된 것): 계약서 작성 요청 / 급여명세서 확정 안내 / 퇴근 누락 안내
SOLAPI_TPL_CONTRACT=
SOLAPI_TPL_PAYSLIP=
# (선택) 급여명세서 확인 링크 알림톡. 직원이 버튼을 눌러 출퇴근 PIN 4자리로 본인 명세서를 보게 한다.
# 이 값이 있으면 급여명세서 알림톡을 위 SOLAPI_TPL_PAYSLIP 대신 이 템플릿으로 보내고, 없으면 기존(안내만) 템플릿으로 보낸다.
# 템플릿 본문: "[사색찬미한정식]\n#{이름}님, #{귀속월} 급여명세서가 확정되었습니다.\n\n임금 지급일: #{지급일}\n아래 버튼에서 PIN 4자리를 입력해 명세서를 확인해 주세요."
# 버튼: 웹링크 "급여명세서 확인", 주소 https://www.saseokchanmi.com/payslip/#{토큰}  (사이트 주소는 NEXT_PUBLIC_SITE_URL과 같아야 한다)
SOLAPI_TPL_PAYSLIP_LINK=
SOLAPI_TPL_MISSING=
# 퇴근 누락 알림톡을 받을 휴대전화. 쉼표로 여러 개 적을 수 있다(예: 010-1111-2222,010-3333-4444). 비워 두면 SOLAPI_TO를 쓴다.
# 알림톡 전용 API 키(문자 권한 없음)를 쓴다면 SOLAPI_TO는 비우고 이 값만 넣는다(SOLAPI_TO가 있으면 문자 발송도 시도해 실패 기록이 남는다).
SOLAPI_KAKAO_TO=
# 템플릿에 등록하는 버튼 링크(알림 속 주소는 NEXT_PUBLIC_SITE_URL로 만들어지니 이 값과 같은 주소로 등록한다):
#   계약서 작성 요청  {사이트 주소}/contract/#{토큰}
#   급여명세서 안내   {사이트 주소}
#   퇴근 누락 안내    {사이트 주소}/admin/clock
