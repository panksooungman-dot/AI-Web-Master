# 실제 도메인이 확정되면 설정한다. 비워두면 lib/site-config.ts의 임시값을 사용한다.
NEXT_PUBLIC_SITE_URL=https://saseokchanmi.com

# ── 근로계약서 관리자 기능 ──
# 관리자 로그인 비밀번호(10자 이상). 값은 채팅·코드에 적지 말고 Vercel 환경변수에만 넣는다.
CONTRACT_ADMIN_PASSWORD=
# 로그인 쿠키 서명용 무작위 문자열(32자 이상). 예: openssl rand -base64 48
CONTRACT_SESSION_SECRET=
# DB 연결 문자열(Neon Postgres). Vercel 프로젝트의 Storage 탭에서 Neon을 만들어 연결하면 자동으로 들어간다.
# 테이블은 첫 요청 때 자동으로 만들어지므로 따로 준비할 것이 없다.
# 운영에서 비어 있으면 API가 503을 돌려준다(서버리스 디스크는 영구 저장이 아니라서 파일에 쓰지 않는다).
# 개발(next dev)에서는 비워 두면 lib/data/contract/ 의 로컬 파일을 쓴다(git 미추적).
DATABASE_URL=
